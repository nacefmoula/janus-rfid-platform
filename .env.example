POSTGRES_DB=janus_db
POSTGRES_USER=janus_app
POSTGRES_PASSWORD=local-dev-db-password-change-me
TERMINAL_DEMO_TOKEN=dev-terminal-token-change-me
ADMIN_DEMO_TOKEN=dev-admin-token-change-me
ASPNETCORE_ENVIRONMENT=Development
FARE_AMOUNT_MILLIMES=1500
FRONTEND_PORT=4280
ANTIPASSBACK_ENABLED=true
ANTIPASSBACK_WINDOW_SECONDS=30
TERMINAL_02_TOKEN=dev-terminal-02-token-change-me
METRICS_SCRAPE_TOKEN=dev-metrics-scrape-token-change-me

# Limitation de débit (req/s par partition d'identité authentifiée ou IP anonyme)
VALIDATIONS_PERMIT_LIMIT=30
ADMIN_PERMIT_LIMIT=15
CARDS_READ_PERMIT_LIMIT=60
ANONYMOUS_PERMIT_LIMIT=30

# Reverse-proxy de confiance (IP statique du conteneur Nginx janus-web sur le réseau janus_net)
TRUSTED_PROXIES=172.28.0.10
TRUSTED_NETWORKS=

# Supervision locale (Grafana lié à 127.0.0.1:3000, accès anonyme désactivé par défaut)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dev-grafana-password-change-me
GRAFANA_ANONYMOUS_ENABLED=false
